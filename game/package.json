{
  "name": "@grindhouse/game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Grindhouse: deterministic skate/combat simulation, Three.js browser client, and the authoritative multiplayer server.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node server/index.mjs",
    "test": "node tools/determinism.mjs 1 && node tools/nettest.mjs 1 4",
    "test:full": "node tools/determinism.mjs 4 && node tools/nettest.mjs 2 8 --jitter 80",
    "accept": "node tools/accept.mjs"
  },
  "dependencies": {
    "ws": "8.18.3",
    "viem": "^2.57.7",
    "@grindhouse/shared": "*",
    "pg": "^8.13.0"
  }
}
